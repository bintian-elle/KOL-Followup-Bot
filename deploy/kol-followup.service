[Unit]
Description=KOL Follow-up continuous monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KOL-Followup-Bot
ExecStart=/home/ubuntu/KOL-Followup-Bot/.venv/bin/python kol_followup.py --monitor
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=30
TimeoutStopSec=15min
UMask=0077

[Install]
WantedBy=multi-user.target
