[Unit]
Description=Bluevua KOL Follow-up Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/work/bintian/KOLFollowup
ExecStart=/home/ubuntu/work/bintian/KOLFollowup/.venv/bin/python /home/ubuntu/work/bintian/KOLFollowup/run_bot.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
