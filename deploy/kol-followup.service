[Unit]
Description=Bluevua KOL Follow-up Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KOL-Followup-Bot
ExecStart=/home/ubuntu/KOL-Followup-Bot/.venv/bin/python run_bot.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
