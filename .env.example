# Gmail OAuth (the mailbox connected to Upfluence)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Gmail Watch publishes mailbox changes to this Pub/Sub topic. Both names are
# fully qualified, and the topic project must match the Gmail OAuth project.
GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/kol-followup-gmail
GMAIL_PUBSUB_SUBSCRIPTION=projects/PROJECT_ID/subscriptions/kol-followup-gmail-ec2

# Optional override for Upfluence classification.
GMAIL_UPFLUENCE_QUERY=
# Pace Gmail thread reads to stay under per-user API quota.
GMAIL_THREAD_INTERVAL_SECONDS=2.5

# Google Sheet. The service account must have Editor access to this sheet.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# Preferred: Slack bot token with chat:write permission.
SLACK_BOT_TOKEN=
# Socket Mode app-level token with connections:write. Required for immediate
# `summary` and `rm` DM commands.
SLACK_APP_TOKEN=
# Alternative: incoming webhook; messages will mention the assigned user.
SLACK_WEBHOOK_URL=
# Testing routing is controlled by the Testing Channel row in Sheet Config.

# true prints planned actions without writing Sheet or Slack.
DRY_RUN=true
